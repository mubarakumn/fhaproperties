
<section class="search-section" aria-label="Search properties">
  <form class="search-form" action="/properties/" method="GET">
    <label>
      <span>Location</span>
      <input
        type="text"
        name="location"
        placeholder="City or state"
        autocomplete="address-level1"
      />
    </label>

    <label>
      <span>Property type</span>
      <select name="type">
        <option value="">All properties</option>
        <option value="land">Land</option>
        <option value="house">Houses</option>
        <option value="commercial">Commercial</option>
      </select>
    </label>

    <label>
      <span>Looking to</span>
      <select name="listingType">
        <option value="sale">Buy</option>
        <option value="rent">Rent</option>
      </select>
    </label>

    <button class="search-button" type="submit">
      Search properties <span>→</span>
    </button>
  </form>
  <p class="search-note">
    Search across locations in Nigeria. Availability is subject to confirmation.
  </p>
</section>

<style>
