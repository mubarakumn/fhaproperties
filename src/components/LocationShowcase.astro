---
const { locations, heading = "Explore property locations", eyebrow = "Browse by location" } = Astro.props;
---

<section class="locations-section" aria-labelledby="locations-heading">
  <div class="container">
    <div class="locations-heading">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="locations-heading">{heading}</h2>
      </div>
      <p class="locations-intro">
        Browse current listings by area. Listings appear here only when they are
        available in our property database.
      </p>
    </div>

    <div class="locations-grid">
      {locations.map((location) => (
        <article class="location-card">
          <a
            class="location-link"
            href={location.count > 0
              ? `/properties/?state=${encodeURIComponent(location.state)}`
              : undefined}
            aria-label={`Browse properties in ${location.name}`}
            aria-disabled={location.count === 0 ? "true" : undefined}
            tabindex={location.count === 0 ? -1 : undefined}
          >
            <div class="location-image">
              <img
                src={location.image}
                alt={location.imageAlt}
                loading="lazy"
                decoding="async"
              />
              <span class="location-image-label">{location.name}</span>
            </div>
            <div class="location-copy">
              <span class="location-region">{location.region}</span>
              <strong>
                {location.count === 0
                  ? "No listings yet"
                  : `${location.count} ${location.count === 1 ? "listing" : "listings"}`}
              </strong>
            </div>
          </a>
          <p class="location-credit">
            Photo: <a href={location.imageCreditUrl} target="_blank" rel="noopener noreferrer">
              {location.imageCredit}
            </a>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .locations-section {
    padding: 72px 0;
    background: #f6f8fb;
  }

  .locations-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 26px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--color-brand);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.4vw, 2.55rem);
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 1.12;
  }

  .locations-intro {
    max-width: 410px;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .location-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: 0 6px 20px rgb(21 38 61 / 5%);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .location-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .location-link {
    display: block;
    color: inherit;
  }

  .location-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.35;
    background: var(--color-surface-soft);
  }

  .location-image::after {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgb(8 23 42 / 58%));
    content: "";
  }

  .location-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .location-card:hover .location-image img {
    transform: scale(1.04);
  }

  .location-image-label {
    position: absolute;
    z-index: 1;
    right: 12px;
    bottom: 11px;
    left: 12px;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .location-copy {
    display: flex;
    min-height: 66px;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 10px 13px;
  }

  .location-region {
    color: var(--color-slate-blue);
    font-size: 0.72rem;
  }

  .location-copy strong {
    color: var(--color-brand);
    font-size: 0.78rem;
  }

  .location-credit {
    margin: 0;
    padding: 0 12px 10px;
    color: var(--color-slate-blue);
    font-size: 0.59rem;
    line-height: 1.5;
  }

  .location-credit a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 1000px) {
    .locations-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .locations-section {
      padding: 52px 0;
    }

    .locations-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .locations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 360px) {
    .locations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
