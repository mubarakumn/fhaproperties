---
import "../styles/global.css";

const {
  title = "FHA Properties Management | Real Estate & Construction",
  description = "Discover properties, land and construction services across Nigeria with FHA Properties Management."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      const path = window.location.pathname;
      if (
        navigator.doNotTrack !== "1" &&
        !path.startsWith("/admin") &&
        !path.startsWith("/api/") &&
        !path.startsWith("/_astro/")
      ) {
        fetch("/api/analytics/visit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ path }),
          credentials: "same-origin",
          keepalive: true,
        }).catch((error) => {
          console.error("Could not record anonymous site page view:", error);
        });
      }
    </script>

    <!-- ── Floating WhatsApp Button ── -->
    <a
      href="https://wa.me/2348039145619?text=Hello%20FHA%20Properties%20Management%2C%20I%20would%20like%20to%20make%20an%20enquiry."
      target="_blank"
      rel="noopener noreferrer"
      class="floating-whatsapp"
      aria-label="Chat with FHA Properties Management on WhatsApp"
      title="Chat with us on WhatsApp"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span class="floating-text">Chat with us</span>
    </a>

    <style>
      .floating-whatsapp {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 999;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px 12px 14px;
        background: var(--color-whatsapp-dark);
        color: var(--color-ivory);
        border-radius: 999px;
        box-shadow: 0 8px 26px rgb(7 94 84 / 24%), 0 2px 8px rgb(29 28 26 / 14%);
        text-decoration: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        min-height: 52px;
        transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
      }

      .floating-whatsapp:hover {
        background: var(--color-whatsapp-deep);
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 6px 20px rgb(37 211 102 / 32%), 0 3px 8px rgb(29 28 26 / 20%);
      }

      .floating-whatsapp svg {
        flex-shrink: 0;
      }

      @media (max-width: 600px) {
        .floating-whatsapp {
          bottom: 20px;
          right: 20px;
          padding: 12px;
          border-radius: 50%;
        }

        .floating-text {
          display: none;
        }
      }
    </style>
  </body>
</html>
