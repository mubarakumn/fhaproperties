</style>

<script>
  // ── Logout logic ──
  const logoutBtn = document.querySelector("#logout-button");
  logoutBtn?.addEventListener("click", async () => {
    logoutBtn.disabled = true;
    logoutBtn.textContent = "Logging out...";
    try {
      const res = await fetch("/api/admin/logout", { method: "POST" });
      if (!res.ok) throw new Error("Logout failed");
      window.location.assign("/admin/login/");
    } catch (err) {
      alert("Unable to log out. Please try again.");
      logoutBtn.disabled = false;
      logoutBtn.textContent = "Log out";
    }
  });

  // ── Tabs Switching ──
  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabPanes = document.querySelectorAll<HTMLElement>(".tab-pane");

  function switchTab(tabId) {
    tabBtns.forEach((btn) => {
      const isActive = btn.dataset.tab === tabId;
      btn.classList.toggle("active", isActive);
      btn.setAttribute("aria-selected", String(isActive));
      btn.tabIndex = isActive ? 0 : -1;
    });
    tabPanes.forEach((pane) => {
      pane.classList.toggle("active", pane.id === `tab-${tabId}`);
    });
    // Sync URL hash
    history.replaceState(null, "", `#${tabId}`);
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => switchTab(btn.dataset.tab));
  });

  document.querySelectorAll("[data-tab-target]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      switchTab(trigger.dataset.tabTarget);
    });
  });

  document.querySelector("#quick-create-btn")?.addEventListener("click", () => {
    switchTab("create");
    document.querySelector("#c-title")?.focus();
  });

  // Check URL hash on page load
  const currentHash = window.location.hash.replace("#", "");
  if (["pending", "published", "other", "create"].includes(currentHash)) {
    switchTab(currentHash);
  }

  tabBtns.forEach((btn, index) => {
    btn.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const nextIndex = (index + direction + tabBtns.length) % tabBtns.length;
      const nextButton = tabBtns[nextIndex];
      switchTab(nextButton.dataset.tab);
      nextButton.focus();
    });
  });

  // ── Actions on Pending Submissions (Approve / Reject) ──
  document.querySelectorAll(".submission-card").forEach((card) => {
    const propertyId = card.dataset.id;
    const notesInput = card.querySelector(".review-notes-input");
    const approveBtn = card.querySelector(".btn-approve");
    const rejectBtn  = card.querySelector(".btn-reject");

    async function handleReview(action) {
      const promptText =
        action === "publish"
          ? "Approve this property and publish it live on the public website?"
          : "Reject this property submission?";

      if (!window.confirm(promptText)) return;

      if (approveBtn) approveBtn.disabled = true;
      if (rejectBtn)  rejectBtn.disabled = true;

      try {
        const res = await fetch(`/api/admin/properties/${encodeURIComponent(propertyId)}/review`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action,
            notes: notesInput?.value?.trim() || "",
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(data.message || data.error || "Action failed.");
        }

        // Animate out card
        card.style.transition = "opacity 200ms ease, transform 200ms ease";
        card.style.opacity = "0";
        card.style.transform = "scale(0.97)";
        setTimeout(() => window.location.reload(), 300);
      } catch (err) {
        alert(err.message || "Failed to perform review action.");
        if (approveBtn) approveBtn.disabled = false;
        if (rejectBtn)  rejectBtn.disabled = false;
      }
    }

    approveBtn?.addEventListener("click", () => handleReview("publish"));
    rejectBtn?.addEventListener("click", () => handleReview("reject"));
  });

  document.querySelectorAll(".gallery-photo-link img, .pub-media img").forEach((image) => {
    if (!(image instanceof HTMLImageElement)) return;

    const showFallback = () => {
      image.hidden = true;
      const fallbackClass = image.closest(".gallery-photo-link")
        ? ".gallery-photo-fallback"
        : ".pub-no-photo";
      const fallback = image.parentElement?.querySelector(fallbackClass);
      if (fallback instanceof HTMLElement) fallback.hidden = false;
    };

    image.addEventListener("error", showFallback, { once: true });
    if (image.complete && image.naturalWidth === 0) showFallback();
  });

  // ── Actions on Published Properties (Unpublish / Delete) ──
  document.querySelectorAll(".pub-card").forEach((card) => {
    const propertyId = card.dataset.id;
    const unpublishBtn = card.querySelector(".btn-pub-unpublish");
    const deleteBtn = card.querySelector(".btn-pub-delete");

    async function handleStatus(action) {
      const confirmText =
        action === "delete"
          ? "Are you sure you want to PERMANENTLY delete this property? This cannot be undone."
          : "Unpublish this property? It will be removed from the public website and saved as a draft.";

      if (!window.confirm(confirmText)) return;

      if (unpublishBtn) unpublishBtn.disabled = true;
      if (deleteBtn) deleteBtn.disabled = true;

      try {
        const res = await fetch(`/api/admin/properties/${encodeURIComponent(propertyId)}/status`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "Failed to update property status.");

        card.style.transition = "opacity 200ms ease, transform 200ms ease";
        card.style.opacity = "0";
        card.style.transform = "scale(0.97)";
        setTimeout(() => window.location.reload(), 300);
      } catch (err) {
        alert(err.message || "Action failed.");
        if (unpublishBtn) unpublishBtn.disabled = false;
        if (deleteBtn) deleteBtn.disabled = false;
      }
    }

    unpublishBtn?.addEventListener("click", () => handleStatus("unpublish"));
    deleteBtn?.addEventListener("click", () => handleStatus("delete"));
  });

  document.querySelectorAll(".other-listing-row").forEach((candidate) => {
    if (!(candidate instanceof HTMLTableRowElement)) return;
    const row = candidate;
    const propertyId = row.dataset.id;
    const publishBtn = row.querySelector(".btn-other-publish");
    const deleteBtn = row.querySelector(".btn-other-delete");

    if (!(publishBtn instanceof HTMLButtonElement) || !(deleteBtn instanceof HTMLButtonElement)) {
      return;
    }

    async function handleOtherListingAction(action: "publish" | "delete") {
      const message = action === "delete"
        ? "Permanently delete this property? This cannot be undone."
        : "Publish this property on the public website?";
      if (!window.confirm(message)) return;

      publishBtn.disabled = true;
      deleteBtn.disabled = true;

      try {
        const response = await fetch(`/api/admin/properties/${encodeURIComponent(propertyId)}/status`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action }),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || "Could not update this listing.");
        }

        window.location.reload();
      } catch (error) {
        alert(error instanceof Error ? error.message : "Could not update this listing.");
        publishBtn.disabled = false;
        deleteBtn.disabled = false;
      }
    }

    publishBtn?.addEventListener("click", () => handleOtherListingAction("publish"));
    deleteBtn?.addEventListener("click", () => handleOtherListingAction("delete"));
  });

  // ── Admin Direct Property Creator Form (Tab 3) ──
  const MAX_IMAGES = 5;
  const MAX_IMAGE_SIZE = 5 * 1024 * 1024;
  const ALLOWED_IMAGE_TYPES = new Set(["image/jpeg", "image/png", "image/webp"]);
  const createForm = document.querySelector("#admin-create-form");
  const createSubmitBtn = document.querySelector("#create-submit-btn");
  const createMsg = document.querySelector("#create-message");
  const adminFileInput = document.querySelector("#admin-file-input");
  const adminDropZone = document.querySelector("#admin-drop-zone");
  const adminPreviewStrip = document.querySelector("#admin-preview-strip");
  const adminUrlSlots = document.querySelector("#admin-url-slots");
  const adminAddUrlBtn = document.querySelector("#admin-add-url");
  const adminImgCounter = document.querySelector("#admin-img-counter");
  const adminLimitWarn = document.querySelector("#admin-limit-warn");
  const adminDesc = document.querySelector("#c-desc");
  const adminDescCount = document.querySelector("#admin-desc-count");

  let adminDt = new DataTransfer();

  // Char count
  adminDesc?.addEventListener("input", () => {
    if (adminDescCount) adminDescCount.textContent = adminDesc.value.length;
  });

  function countAdminImages() {
    const urlCount = adminUrlSlots?.querySelectorAll("input[type=url]").length || 0;
    return adminDt.files.length + urlCount;
  }

  function updateAdminImageUI() {
    const total = countAdminImages();
    const atLimit = total >= MAX_IMAGES;

    if (adminImgCounter) {
      adminImgCounter.textContent = `${total} / ${MAX_IMAGES} image${total !== 1 ? "s" : ""}`;
    }
    if (adminLimitWarn) adminLimitWarn.hidden = !atLimit;
    if (adminAddUrlBtn) adminAddUrlBtn.disabled = atLimit;

    if (adminDropZone) {
      adminDropZone.style.opacity = atLimit ? "0.45" : "";
      adminDropZone.style.pointerEvents = atLimit ? "none" : "";
    }
  }

  function renderAdminThumbnails() {
    if (!adminPreviewStrip) return;
    adminPreviewStrip.innerHTML = "";

    Array.from(adminDt.files).forEach((file, index) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const box = document.createElement("div");
        box.className = "thumb-box";

        const img = document.createElement("img");
        img.src = e.target.result;
        img.alt = file.name;

        const del = document.createElement("button");
        del.type = "button";
        del.className = "thumb-del";
        del.textContent = "×";
        del.title = `Remove ${file.name}`;
        del.addEventListener("click", () => {
          const freshDt = new DataTransfer();
          Array.from(adminDt.files).forEach((f, i) => {
            if (i !== index) freshDt.items.add(f);
          });
          adminDt = freshDt;
          renderAdminThumbnails();
          updateAdminImageUI();
        });

        box.appendChild(img);
        box.appendChild(del);
        adminPreviewStrip.appendChild(box);
      };
      reader.readAsDataURL(file);
    });

    updateAdminImageUI();
  }

  function addAdminFiles(files) {
    if (createMsg) createMsg.hidden = true;
    const urlCount = adminUrlSlots?.querySelectorAll("input[type=url]").length || 0;
    const remaining = MAX_IMAGES - adminDt.files.length - urlCount;
    const incoming = Array.from(files);
    const invalidFiles = incoming.filter(
      (file) => !ALLOWED_IMAGE_TYPES.has(file.type) || file.size > MAX_IMAGE_SIZE,
    );
    const validFiles = incoming.filter(
      (file) => ALLOWED_IMAGE_TYPES.has(file.type) && file.size <= MAX_IMAGE_SIZE,
    );
    const uniqueFiles = validFiles.filter(
      (file) =>
        !Array.from(adminDt.files).some(
          (existing) => existing.name === file.name && existing.size === file.size,
        ),
    );

    if (invalidFiles.length) {
      showAdminImageError("Photos must be JPEG, PNG, or WebP files no larger than 5 MB each.");
    }
    if (uniqueFiles.length > remaining) {
      showAdminImageError(`Only ${Math.max(remaining, 0)} more photos can be added. The limit is ${MAX_IMAGES} total.`);
    }

    uniqueFiles.slice(0, Math.max(remaining, 0)).forEach((file) => adminDt.items.add(file));
    adminFileInput.value = "";
    renderAdminThumbnails();
  }

  function showAdminImageError(message) {
    if (!createMsg) return;
    createMsg.hidden = false;
    createMsg.className = "creator-msg msg-error";
    createMsg.textContent = message;
  }

  adminFileInput?.addEventListener("change", () => addAdminFiles(adminFileInput.files));

  adminDropZone?.addEventListener("click", () => adminFileInput?.click());
  adminDropZone?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      adminFileInput?.click();
    }
  });

  ["dragenter", "dragover"].forEach((evt) => {
    adminDropZone?.addEventListener(evt, (e) => {
      e.preventDefault();
      adminDropZone.classList.add("drag-over");
    });
  });

  ["dragleave", "drop"].forEach((evt) => {
    adminDropZone?.addEventListener(evt, (e) => {
      e.preventDefault();
      adminDropZone.classList.remove("drag-over");
    });
  });

  adminDropZone?.addEventListener("drop", (e) => {
    const files = e.dataTransfer?.files;
    if (files?.length) addAdminFiles(files);
  });

  // URL Slots
  function addAdminUrlSlot() {
    if (!adminUrlSlots || countAdminImages() >= MAX_IMAGES) return;

    const row = document.createElement("div");
    row.className = "url-row";

    const input = document.createElement("input");
    input.type = "url";
    input.name = "imageUrls";
    input.placeholder = "https://example.com/property-photo.jpg";
    input.required = true;
    input.pattern = "https://.+";
    input.title = "Enter a direct HTTPS image URL.";

    const rm = document.createElement("button");
    rm.type = "button";
    rm.className = "btn-remove-url";
    rm.textContent = "×";
    rm.title = "Remove URL";
    rm.addEventListener("click", () => {
      row.remove();
      updateAdminImageUI();
    });

    row.appendChild(input);
    row.appendChild(rm);
    adminUrlSlots.appendChild(row);
    input.focus();
    updateAdminImageUI();
  }

  adminAddUrlBtn?.addEventListener("click", addAdminUrlSlot);

  // Form Submission
  createForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!createForm.reportValidity()) return;

    if (countAdminImages() > MAX_IMAGES) {
      alert(`You can attach a maximum of ${MAX_IMAGES} images.`);
      return;
    }

    createSubmitBtn.disabled = true;
    const btnLbl = createSubmitBtn.querySelector(".btn-lbl");
    const btnSpin = createSubmitBtn.querySelector(".btn-spin");
    if (btnLbl) btnLbl.hidden = true;
    if (btnSpin) btnSpin.hidden = false;

    if (createMsg) createMsg.hidden = true;

    try {
      const fd = new FormData(createForm);
      fd.delete("images");
      Array.from(adminDt.files).forEach((f) => fd.append("images", f));

      const res = await fetch("/api/admin/properties/create", {
        method: "POST",
        body: fd,
      });

      const data = await res.json();

      if (createMsg) {
        createMsg.hidden = false;
        createMsg.className = `creator-msg ${res.ok && data.success ? "msg-success" : "msg-error"}`;
        createMsg.textContent = data.message || "Failed to create property.";
      }

      if (res.ok && data.success) {
        createForm.reset();
        adminDt = new DataTransfer();
        if (adminPreviewStrip) adminPreviewStrip.innerHTML = "";
        if (adminUrlSlots) adminUrlSlots.innerHTML = "";
        if (adminDescCount) adminDescCount.textContent = "0";
        updateAdminImageUI();

        // Reload to published tab after 1.5s so admin can see their live listing
        setTimeout(() => {
          window.location.hash = "published";
          window.location.reload();
        }, 1200);
      }
    } catch (err) {
      if (createMsg) {
        createMsg.hidden = false;
        createMsg.className = "creator-msg msg-error";
        createMsg.textContent = "Network error. Please try again.";
      }
    } finally {
      createSubmitBtn.disabled = false;
      if (btnLbl) btnLbl.hidden = false;
      if (btnSpin) btnSpin.hidden = true;
    }
  });

  updateAdminImageUI();
</script>