            </div>

            <div class="f-grid contact-grid">
              <div class="f-group">
                <label for="c-contactName">Contact Name</label>
                <input id="c-contactName" name="contactName" type="text" value="FHA Properties Management" />
              </div>
              <div class="f-group">
                <label for="c-contactPhone">Contact Phone</label>
                <input id="c-contactPhone" name="contactPhone" type="tel" value="+234 906 671 5348" />
              </div>
              <div class="f-group">
                <label for="c-contactEmail">Contact Email</label>
                <input id="c-contactEmail" name="contactEmail" type="email" value="fehintolahayodeji@gmail.com" />
              </div>
            </div>

            <div id="create-message" class="creator-msg" role="alert" hidden></div>

            <button id="create-submit-btn" class="btn-publish-submit" type="submit">
              <span class="btn-lbl">Publish Property</span>
              <span class="btn-spin" hidden>⏳ Saving...</span>
            </button>
          </div>
        </form>
      </section>
    </div>
  </main>
</BaseLayout>

