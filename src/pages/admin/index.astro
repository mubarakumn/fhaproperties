---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { connectDB } from "../../lib/db.js";
import { getAdminFromCookies } from "../../lib/adminAuth.js";
import Property from "../../models/Property.js";

export const prerender = false;

const admin = await getAdminFromCookies(Astro.cookies);

if (!admin) {
  return Astro.redirect("/admin/login/");
}

let pendingSubmissions = [];
let publishedProperties = [];
let draftsAndArchived = [];
let loadError = false;

try {
  await connectDB();

  [pendingSubmissions, publishedProperties, draftsAndArchived] = await Promise.all([
    Property.find({ status: "pending_review" }).sort({ createdAt: -1 }).lean(),
    Property.find({ status: "published" }).sort({ publishedAt: -1, createdAt: -1 }).lean(),
    Property.find({ status: { $in: ["draft", "rejected", "archived"] } }).sort({ updatedAt: -1 }).lean(),
  ]);
} catch (error) {
  console.error("Failed to load admin dashboard properties:", error);
  loadError = true;
}

const fhaCount = publishedProperties.filter((p) => p.source === "fha").length;
---

<BaseLayout
  title="Admin Dashboard | FHA Properties Management"
  description="Manage listings, review submissions, and publish new properties."
>
  <main class="admin-dashboard">
    <!-- Top Navigation Bar -->
    <header class="dashboard-topbar">
      <div class="topbar-inner">
        <div class="brand-group">
          <a href="/admin/" class="admin-brand" aria-label="FHA Properties Management dashboard">
            <img class="admin-logo" src="/fha_logo.png" alt="" width="118" height="79" />
            <span class="brand-tag">MANAGEMENT DASHBOARD</span>
          </a>
        </div>

        <div class="topbar-actions">
          <span class="admin-pill">
            <span class="admin-dot" aria-hidden="true"></span>
            Logged in as <strong>{admin}</strong>
          </span>

          <a href="/properties/" target="_blank" rel="noopener noreferrer" class="link-btn">
            View Live Site ↗
          </a>

          <button id="logout-button" class="btn-logout" type="button">
            Log out
          </button>
        </div>
      </div>
    </header>

    <div class="admin-content">
      <!-- Title + Quick Action Row -->
      <section class="dashboard-head">
        <div>
          <p class="eyebrow">ADMINISTRATION CONSOLE</p>
          <h1>Property Management</h1>
          <p class="lead">
            Review incoming submissions from the public, publish official FHA properties, and manage active listings.
          </p>
        </div>

        <button id="quick-create-btn" class="btn-gold-action" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Publish New Property
        </button>
      </section>

      <!-- Global Alert / Message -->
      <div id="global-message" role="alert" aria-live="polite" hidden></div>

      <!-- Overview Stats Cards -->
      <div class="stats-grid">
        <button class="stat-card stat-btn" data-tab-target="pending" type="button">
          <div class="stat-icon pending-icon">⏳</div>
          <div class="stat-data">
            <span class="stat-number">{pendingSubmissions.length}</span>
            <span class="stat-label">Pending Review</span>
          </div>
        </button>

        <button class="stat-card stat-btn" data-tab-target="published" type="button">
          <div class="stat-icon live-icon">🌐</div>
          <div class="stat-data">
            <span class="stat-number">{publishedProperties.length}</span>
            <span class="stat-label">Live on Website</span>
          </div>
        </button>

        <div class="stat-card">
          <div class="stat-icon fha-icon">🏛️</div>
          <div class="stat-data">
            <span class="stat-number">{fhaCount}</span>
            <span class="stat-label">Official FHA Listings</span>
          </div>
        </div>

        <button class="stat-card stat-btn" data-tab-target="create" type="button">
          <div class="stat-icon add-icon">➕</div>
          <div class="stat-data">
            <span class="stat-number">Create</span>
            <span class="stat-label">Add Listing Directly</span>
          </div>
        </button>

        <button class="stat-card stat-btn" data-tab-target="other" type="button">
          <div class="stat-icon other-icon">↗</div>
          <div class="stat-data">
            <span class="stat-number">{draftsAndArchived.length}</span>
            <span class="stat-label">Drafts & Archived</span>
          </div>
        </button>
      </div>

      <!-- Navigation Tabs -->
      <nav class="dashboard-tabs" aria-label="Dashboard sections" role="tablist">
        <button class="tab-btn active" id="tab-button-pending" role="tab" aria-controls="tab-pending" aria-selected="true" tabindex="0" data-tab="pending" type="button">
          Submissions Awaiting Review
          <span class="tab-badge">{pendingSubmissions.length}</span>
        </button>
        <button class="tab-btn" id="tab-button-published" role="tab" aria-controls="tab-published" aria-selected="false" tabindex="-1" data-tab="published" type="button">
          Published Listings
          <span class="tab-badge">{publishedProperties.length}</span>
        </button>
        <button class="tab-btn" id="tab-button-other" role="tab" aria-controls="tab-other" aria-selected="false" tabindex="-1" data-tab="other" type="button">
          Drafts & Archived
          <span class="tab-badge">{draftsAndArchived.length}</span>
        </button>
        <button class="tab-btn" id="tab-button-create" role="tab" aria-controls="tab-create" aria-selected="false" tabindex="-1" data-tab="create" type="button">
          + Publish New Property
        </button>
      </nav>

      {loadError && (
        <div class="notice-box error-box">
          <h3>Database Connection Error</h3>
          <p>Unable to connect to the database. Please verify your connection settings.</p>
          <button class="btn-refresh" type="button" onclick="window.location.reload()">Reload Page</button>
        </div>
      )}

      <!-- =============================================================== -->
      <!-- TAB 1: PENDING SUBMISSIONS REVIEW -->
      <!-- =============================================================== -->
      <section id="tab-pending" class="tab-pane active" role="tabpanel" aria-labelledby="tab-button-pending">
        <div class="pane-header">
          <div>
            <h2>Pending Submissions ({pendingSubmissions.length})</h2>
            <p>Submissions from the public awaiting verification before appearing live on the website.</p>
          </div>
        </div>

        {pendingSubmissions.length === 0 ? (
          <div class="empty-box">
            <div class="empty-symbol">✓</div>
            <h3>All Caught Up</h3>
            <p>There are no property submissions currently waiting for review.</p>
          </div>
        ) : (
          <div class="submissions-grid">
            {pendingSubmissions.map((property) => (
              <article class="submission-card" data-id={property._id.toString()}>
                <div class="card-top">
                  <div class="card-titles">
                    <span class="badge badge-pending">Pending Review</span>
                    <h3>{property.title}</h3>
                    <p class="card-geo">
                      📍 {[property.address, property.city, property.state].filter(Boolean).join(", ") || "Location not specified"}
                    </p>
                  </div>
                  <div class="card-price-badge">
                    {property.priceLabel ||
                      (property.priceAmount != null
                        ? `₦${Number(property.priceAmount).toLocaleString("en-NG")}`
                        : "Price on request")}
                  </div>
                </div>

                <!-- Photos Gallery -->
                {property.images && property.images.length > 0 && (
                  <div class="property-gallery-strip">
                    {property.images.map((src, index) => (
                      <a href={src} target="_blank" rel="noopener noreferrer" class="gallery-photo-link" title={`Click to view full photo ${index + 1}`}>
                        <img src={src} alt={`Photo ${index + 1} of ${property.title}`} loading="lazy" />
                        <span class="gallery-photo-fallback" hidden>Photo unavailable</span>
                      </a>
                    ))}
                  </div>
                )}

                <!-- Specs Row -->
                <div class="specs-bar">
                  <div class="spec-cell">
                    <span class="spec-label">Type</span>
                    <strong>{property.type || "—"}</strong>
                  </div>
                  <div class="spec-cell">
                    <span class="spec-label">Purpose</span>
                    <strong>For {property.listingType || "Sale"}</strong>
                  </div>
                  <div class="spec-cell">
                    <span class="spec-label">Bedrooms</span>
                    <strong>{property.bedrooms ?? "—"}</strong>
                  </div>
                  <div class="spec-cell">
                    <span class="spec-label">Bathrooms</span>
                    <strong>{property.bathrooms ?? "—"}</strong>
                  </div>
                  <div class="spec-cell">
                    <span class="spec-label">Area</span>
                    <strong>{property.area || "—"}</strong>
                  </div>
                  <div class="spec-cell">
                    <span class="spec-label">Submitted</span>
                    <strong>
                      {property.createdAt
                        ? new Date(property.createdAt).toLocaleDateString("en-NG", { day: "numeric", month: "short", year: "numeric" })
                        : "—"}
                    </strong>
                  </div>
                </div>

                <!-- Description -->
                <div class="desc-box">
                  <h4>Description</h4>
                  <p>{property.description}</p>
                </div>

                <!-- Features if any -->
                {property.features && property.features.length > 0 && (
                  <div class="features-wrap">
                    <h4>Features</h4>
                    <div class="tags-list">
                      {property.features.map((feat) => (
                        <span class="feature-tag">{feat}</span>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Submitter Contact Information -->
                <div class="contact-box">
                  <div class="contact-head">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <strong>Submitter Details:</strong>
                  </div>
                  <div class="contact-data-row">
                    <span><strong>Name:</strong> {property.submittedBy?.name || "Not provided"}</span>
                    <span>
                      <strong>Phone:</strong>{" "}
                      {property.submittedBy?.phone ? (
                        <a href={`tel:${property.submittedBy.phone}`} class="tel-link">
                          {property.submittedBy.phone}
                        </a>
                      ) : "Not provided"}
                    </span>
                    {property.submittedBy?.email && (
                      <span>
                        <strong>Email:</strong>{" "}
                        <a href={`mailto:${property.submittedBy.email}`} class="mail-link">
                          {property.submittedBy.email}
                        </a>
                      </span>
                    )}
                  </div>
                </div>

                <!-- Review Notes Input -->
                <div class="review-comment-wrap">
                  <label for={`notes-${property._id}`}>Review notes / memo (optional):</label>
                  <input
                    id={`notes-${property._id}`}
                    type="text"
                    class="review-notes-input"
                    placeholder="e.g. Verified by phone call, documentation in order"
                    maxlength="500"
                  />
                </div>

                <!-- Action Buttons -->
                <div class="card-actions-row">
                  <a href={`/admin/properties/${property._id}/edit/`} class="btn-edit-property">
                    ✏️ Edit
                  </a>
                  <button class="btn-approve" data-action="publish" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    Approve & Publish Live
                  </button>
                  <button class="btn-reject" data-action="reject" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Reject Submission
                  </button>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <!-- =============================================================== -->
      <!-- TAB 2: PUBLISHED PROPERTIES LIST -->
      <!-- =============================================================== -->
      <section id="tab-published" class="tab-pane" role="tabpanel" aria-labelledby="tab-button-published">
        <div class="pane-header">
          <div>
            <h2>Published Properties ({publishedProperties.length})</h2>
            <p>Active listings currently live and visible on the FHA Properties Management website.</p>
          </div>
        </div>

        {publishedProperties.length === 0 ? (
          <div class="empty-box">
            <div class="empty-symbol">ℹ️</div>
            <h3>No Published Properties Yet</h3>
            <p>Publish a new property directly using the creator tab or approve pending submissions.</p>
          </div>
        ) : (
          <div class="published-grid">
            {publishedProperties.map((property) => (
              <article class="pub-card" data-id={property._id.toString()}>
                <div class="pub-media">
                  {property.images?.[0] && (
                    <img
                      src={property.images[0]}
                      alt={property.title}
                      loading="lazy"
                    />
                  )}
                  <div class="pub-no-photo" hidden={Boolean(property.images?.[0])}>Photo unavailable</div>
                  <div class="pub-badges">
                    <span class={`badge ${property.source === "fha" ? "badge-fha" : "badge-approved"}`}>
                      {property.source === "fha" ? "🏛️ Official FHA" : "✓ Approved Public"}
                    </span>
                    <span class="badge badge-purpose">For {property.listingType}</span>
                  </div>
                </div>

                <div class="pub-body">
                  <div class="pub-type-line">
                    <span class="pub-type">{property.type}</span>
                    <span class="pub-price">
                      {property.priceLabel ||
                        (property.priceAmount != null
                          ? `₦${Number(property.priceAmount).toLocaleString("en-NG")}`
                          : "Price on request")}
                    </span>
                  </div>

                  <h3 class="pub-title">{property.title}</h3>
                  <p class="pub-location">📍 {[property.city, property.state].filter(Boolean).join(", ")}</p>

                  <div class="pub-meta-row">
                    {property.bedrooms != null && <span>🛏️ {property.bedrooms} beds</span>}
                    {property.bathrooms != null && <span>🚿 {property.bathrooms} baths</span>}
                    {property.area && <span>📐 {property.area}</span>}
                  </div>

                  <div class="pub-actions">
                    <a href={`/properties/${property.slug}/`} target="_blank" rel="noopener noreferrer" class="btn-pub-view">
                      View Live ↗
                    </a>
                    <a href={`/admin/properties/${property._id}/edit/`} class="btn-pub-edit">
                      Edit
                    </a>
                    <button class="btn-pub-unpublish" data-action="unpublish" type="button" title="Move back to draft">
                      Unpublish
                    </button>
                    <button class="btn-pub-delete" data-action="delete" type="button" title="Delete property permanently">
                      Delete
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <section id="tab-other" class="tab-pane" role="tabpanel" aria-labelledby="tab-button-other">
        <div class="pane-header">
          <div>
            <h2>Drafts & Archived ({draftsAndArchived.length})</h2>
            <p>Listings that are not currently visible on the public website.</p>
          </div>
        </div>

        {draftsAndArchived.length === 0 ? (
          <div class="empty-box">
            <div class="empty-symbol">✓</div>
            <h3>No inactive listings</h3>
            <p>Draft, rejected, and archived properties will appear here.</p>
          </div>
        ) : (
          <div class="other-listings-wrap">
            <table class="other-listings-table">
              <thead>
                <tr>
                  <th scope="col">Property</th>
                  <th scope="col">Status</th>
                  <th scope="col">Price</th>
                  <th scope="col">Last updated</th>
                  <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                {draftsAndArchived.map((property) => (
                  <tr class="other-listing-row" data-id={property._id.toString()}>
                    <td>
                      <strong>{property.title}</strong>
                      <span>{[property.city, property.state].filter(Boolean).join(", ") || "Location not specified"}</span>
                    </td>
                    <td>
                      <span class={`status-label status-${property.status}`}>
                        {property.status.replaceAll("_", " ")}
                      </span>
                    </td>
                    <td>
                      {property.priceLabel ||
                        (property.priceAmount != null
                          ? `₦${Number(property.priceAmount).toLocaleString("en-NG")}`
                          : "Price on request")}
                    </td>
                    <td>
                      {property.updatedAt
                        ? new Date(property.updatedAt).toLocaleDateString("en-NG", { day: "numeric", month: "short", year: "numeric" })
                        : "—"}
                    </td>
                    <td>
                      <div class="other-listing-actions">
                        <a href={`/admin/properties/${property._id}/edit/`} class="btn-other-edit">
                          Edit
                        </a>
                        <button class="btn-other-publish" data-action="publish" type="button">
                          Publish
                        </button>
                        <button class="btn-other-delete" data-action="delete" type="button">
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <!-- =============================================================== -->
      <!-- TAB 3: PUBLISH NEW PROPERTY (ADMIN DIRECT CREATOR) -->
      <!-- =============================================================== -->
      <section id="tab-create" class="tab-pane" role="tabpanel" aria-labelledby="tab-button-create">
        <div class="pane-header">
          <div>
            <h2>Publish a New Property</h2>
            <p>Directly create and publish an official FHA listing to the website without going through review.</p>
          </div>
        </div>

        <form id="admin-create-form" class="creator-form" novalidate>
          <!-- Section 1: Property Info -->
          <div class="form-box">
            <div class="form-box-head">
              <span class="f-num">01</span>
              <div>
                <h3>Basic Information</h3>
                <p>Title, type, and purpose of the property.</p>
              </div>
            </div>

            <div class="f-grid">
              <div class="f-group full-width">
                <label for="c-title">Property Title <span class="req">*</span></label>
                <input
                  id="c-title"
                  name="title"
                  type="text"
                  placeholder="e.g. Luxury 4-Bedroom Detached Duplex in Maitama, Abuja"
                  required
                  maxlength="160"
                />
              </div>

              <div class="f-group">
                <label for="c-type">Property Type <span class="req">*</span></label>
                <select id="c-type" name="type" required>
                  <option value="">Select property type</option>
                  <option value="House">House</option>
                  <option value="Apartment">Apartment</option>
                  <option value="Land">Land</option>
                  <option value="Commercial">Commercial Property</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="f-group">
                <label for="c-listingType">Listing Purpose <span class="req">*</span></label>
                <select id="c-listingType" name="listingType" required>
                  <option value="Sale">For Sale</option>
                  <option value="Rent">For Rent</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Section 2: Location -->
          <div class="form-box">
            <div class="form-box-head">
              <span class="f-num">02</span>
              <div>
                <h3>Location Details</h3>
                <p>Specify state, city, and street address.</p>
              </div>
            </div>

            <div class="f-grid">
              <div class="f-group">
                <label for="c-state">State <span class="req">*</span></label>
                <input id="c-state" name="state" type="text" placeholder="e.g. Abuja FCT, Lagos, Lagos" required maxlength="80" />
              </div>

              <div class="f-group">
                <label for="c-city">City / District <span class="req">*</span></label>
                <input id="c-city" name="city" type="text" placeholder="e.g. Maitama, Lekki, GRA" required maxlength="100" />
              </div>

              <div class="f-group full-width">
                <label for="c-address">Street Address / Landmark (optional)</label>
                <input id="c-address" name="address" type="text" placeholder="e.g. Plot 402, Constitution Avenue" maxlength="250" />
              </div>
            </div>
          </div>

          <!-- Section 3: Pricing & Specifications -->
          <div class="form-box">
            <div class="form-box-head">
              <span class="f-num">03</span>
              <div>
                <h3>Pricing & Specifications</h3>
                <p>Financial details, rooms, and dimensions.</p>
              </div>
            </div>

            <div class="f-grid">
              <div class="f-group">
                <label for="c-price">Price in Naira (₦)</label>
                <div class="prefix-wrap">
                  <span class="prefix">₦</span>
                  <input id="c-price" name="priceAmount" type="number" min="0" step="1" placeholder="e.g. 85000000" class="input-with-prefix" />
                </div>
              </div>

              <div class="f-group">
                <label for="c-priceLabel">Price Note / Label (optional)</label>
                <input id="c-priceLabel" name="priceLabel" type="text" placeholder="e.g. Negotiable, ₦25M / annum" maxlength="100" />
              </div>

              <div class="f-group">
                <label for="c-beds">Bedrooms</label>
                <input id="c-beds" name="bedrooms" type="number" min="0" max="100" placeholder="0" />
              </div>

              <div class="f-group">
                <label for="c-baths">Bathrooms</label>
                <input id="c-baths" name="bathrooms" type="number" min="0" max="100" placeholder="0" />
              </div>

              <div class="f-group">
                <label for="c-area">Total Area / Size</label>
                <input id="c-area" name="area" type="text" placeholder="e.g. 650 sqm, 2 Plots" maxlength="100" />
              </div>

              <div class="f-group">
                <label for="c-features">Key Features (comma-separated)</label>
                <input id="c-features" name="features" type="text" placeholder="e.g. Swimming Pool, Borehole, CCTV, 24/7 Security" />
              </div>
            </div>
          </div>

          <!-- Section 4: Description -->
          <div class="form-box">
            <div class="form-box-head">
              <span class="f-num">04</span>
              <div>
                <h3>Property Description <span class="req">*</span></h3>
                <p>Provide a comprehensive overview of the property.</p>
              </div>
            </div>

            <div class="f-group full-width">
              <textarea
                id="c-desc"
                name="description"
                rows="6"
                placeholder="Describe the architectural condition, compound, surrounding amenities, access roads, and documentation (e.g., C of O, Governor's Consent)."
                required
                minlength="20"
                maxlength="5000"
              ></textarea>
              <div class="char-bar"><span id="admin-desc-count">0</span> / 5000</div>
            </div>
          </div>

          <!-- Section 5: Property Images (Upload up to 5 photos or URLs) -->
          <div class="form-box">
            <div class="form-box-head">
              <span class="f-num">05</span>
              <div>
                <h3>Property Images (Up to 5)</h3>
                <p>Upload photos from your computer or paste direct image links.</p>
              </div>
            </div>

            <!-- Drag & Drop Zone -->
            <div id="admin-drop-zone" class="drop-target" role="button" tabindex="0">
              <input
                id="admin-file-input"
                name="images"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                multiple
                class="sr-only"
                tabindex="-1"
              />
              <div class="drop-content">
                <div class="drop-icon">📷</div>
                <p><strong>Click to browse photos</strong> or drag & drop files here</p>
                <small>JPEG, PNG, WebP · Max 5MB per file · Up to 5 images total</small>
              </div>
            </div>

            <!-- Preview thumbnails -->
            <div id="admin-preview-strip" class="preview-strip"></div>

            <!-- URL Slots -->
            <div class="url-block">
              <p class="url-heading">Or add image URLs:</p>
              <div id="admin-url-slots" class="url-slots-col"></div>
              <button id="admin-add-url" class="btn-sub-action" type="button">
                + Add Image Link (URL)
              </button>
            </div>

            <div class="counter-row">
              <span id="admin-img-counter" class="img-badge">0 / 5 images</span>
              <span id="admin-limit-warn" class="warn-text" hidden>Maximum 5 images reached.</span>
            </div>
          </div>

          <!-- Section 6: Publishing Options & Contact -->
          <div class="form-box submit-box">
            <div class="publish-choice-row">
              <label class="radio-card">
                <input type="radio" name="status" value="published" checked />
                <div class="radio-text">
