
---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Submit a Property | FHA Properties Management"
  description="Submit your property for review by FHA Properties Management. We list homes, land, apartments and commercial properties across Nigeria."
>
  <Header />

  <main class="submit-page">

    <!-- ── Page hero ── -->
    <div class="page-hero">
      <div class="page-hero-inner container-wide">
        <div class="hero-text">
          <p class="eyebrow">PROPERTY SUBMISSION</p>
          <h1>List your property<br />with <em>FHA.</em></h1>
          <p class="hero-sub">
            Fill in the details below and our team will review your listing
            before it goes live on the FHA Properties Management platform.
          </p>
        </div>
        <div class="hero-trust">
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">✓</span>
            <span>Free to submit</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">✓</span>
            <span>Reviewed within 48 hrs</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">✓</span>
            <span>Nationwide coverage</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Main layout ── -->
    <div class="page-body container-wide">

      <!-- ── Left: form ── -->
      <div class="form-col">

        <!-- Success screen (hidden by default) -->
        <div id="success-screen" class="success-screen" hidden>
          <div class="success-icon" aria-hidden="true">
            <svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg" width="52" height="52">
              <circle cx="26" cy="26" r="25" stroke="#01316D" stroke-width="2"/>
              <path d="M15 26.5l8 8 14-16" stroke="#01316D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2>Property submitted!</h2>
          <p>
            Thank you. Our team will review your listing and get back to you
            within 48 hours. You'll be contacted on the details you provided.
          </p>
          <a href="/properties/" class="btn-primary">Browse properties</a>
          <button id="submit-another" type="button" class="btn-ghost">Submit another property</button>
        </div>

        <!-- The form -->
        <form id="property-form" class="submission-form" novalidate>
          <nav class="form-progress" aria-label="Submission steps">
            <a href="#section-property" class="progress-step" data-progress-step="section-property" aria-current="step">
              <span>01</span><strong>Property details</strong>
            </a>
            <a href="#section-images" class="progress-step" data-progress-step="section-images">
              <span>02</span><strong>Photos &amp; video</strong>
            </a>
            <a href="#section-contact" class="progress-step" data-progress-step="section-contact">
              <span>03</span><strong>Your contact</strong>
            </a>
          </nav>

          <!-- ── Section 1: Property details ── -->
          <section class="form-section" id="section-property">
            <div class="section-header">
              <span class="section-number" aria-hidden="true">01</span>
              <div>
                <h2>Property details</h2>
                <p class="section-desc">Tell us about the property you want to list.</p>
              </div>
            </div>

            <div class="fields">

              <div class="field-group">
                <label for="f-title">
                  Property title
                  <span class="required" aria-hidden="true">*</span>
                </label>
                <input
                  id="f-title"
                  name="title"
                  type="text"
                  placeholder="e.g. Three-bedroom house in GRA, Lagos"
                  minlength="5"
                  maxlength="160"
                  required
                  autocomplete="off"
                />
                <p class="field-hint">Give a clear, descriptive title for your property.</p>
              </div>

              <div class="field-row">
                <div class="field-group">
                  <label for="f-type">
                    Property type
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <div class="select-wrap">
                    <select id="f-type" name="type" required>
                      <option value="">Select type</option>
                      <option value="House">House</option>
                      <option value="Apartment">Apartment</option>
                      <option value="Land">Land</option>
                      <option value="Commercial">Commercial property</option>
                      <option value="Other">Other</option>
                    </select>
                  </div>
                </div>

                <div class="field-group">
                  <label for="f-listing-type">
                    Listing purpose
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <div class="select-wrap">
                    <select id="f-listing-type" name="listingType" required>
                      <option value="">Select purpose</option>
                      <option value="Sale">For sale</option>
                      <option value="Rent">For rent</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="field-divider"></div>
              <p class="field-group-label">Location</p>

              <div class="field-row">
                <div class="field-group">
                  <label for="f-state">
                    State
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <input
                    id="f-state"
                    name="state"
                    type="text"
                    placeholder="e.g. Lagos"
                    maxlength="80"
                    required
                  />
                </div>

                <div class="field-group">
                  <label for="f-city">
                    City or town
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <input
                    id="f-city"
                    name="city"
                    type="text"
                    placeholder="e.g. Ikeja"
                    maxlength="100"
                    required
                  />
                </div>
              </div>

              <div class="field-group">
                <label for="f-address">Street address or area</label>
                <input
                  id="f-address"
                  name="address"
                  type="text"
                  placeholder="Neighbourhood, street or landmark (optional)"
                  maxlength="250"
                />
              </div>

              <div class="field-divider"></div>
              <p class="field-group-label">Pricing</p>

              <div class="field-row">
                <div class="field-group">
                  <label for="f-price">Price (₦)</label>
                  <div class="input-prefix-wrap">
                    <span class="input-prefix" aria-hidden="true">₦</span>
                    <input
                      id="f-price"
                      name="priceAmount"
                      type="number"
                      min="0"
                      step="1"
                      placeholder="e.g. 25000000"
                      class="has-prefix"
                    />
                  </div>
                </div>

                <div class="field-group">
                  <label for="f-price-label">Price note</label>
                  <input
                    id="f-price-label"
                    name="priceLabel"
                    type="text"
                    maxlength="100"
                    placeholder="e.g. Negotiable, per annum"
                  />
                </div>
              </div>

              <div class="field-group">
                <label for="f-agent-fee">Buyer-paid agent fee / commission (%)</label>
                <input
                  id="f-agent-fee"
                  name="agentFeePercent"
                  type="number"
                  min="0"
                  max="100"
                  step="0.1"
                  value="0"
                  placeholder="e.g. 5 or 10"
                />
                <p class="field-hint">
                  This percentage is added to the asking price and included in
                  the total shown to buyers. Enter 0 if no fee applies.
                </p>
              </div>

              <div id="f-price-preview" class="price-preview" aria-live="polite" hidden>
                <p class="price-preview-title">Buyer-facing price estimate</p>
                <div class="price-preview-line">
                  <span>Asking price</span>
                  <strong id="f-preview-asking"></strong>
                </div>
                <div id="f-preview-fee-row" class="price-preview-line" hidden>
                  <span id="f-preview-fee-label">Agent fee</span>
                  <strong id="f-preview-fee"></strong>
                </div>
                <div class="price-preview-total">
                  <span>Estimated total for buyer</span>
                  <strong id="f-preview-total"></strong>
                </div>
                <p id="f-preview-note" class="price-preview-note"></p>
              </div>

              <div class="field-divider"></div>
              <p class="field-group-label">Property specs <span class="optional-tag">optional</span></p>

              <div class="field-row field-row-3">
                <div class="field-group">
                  <label for="f-beds">Bedrooms</label>
                  <input id="f-beds" name="bedrooms" type="number" min="0" max="100" step="1" placeholder="0" />
                </div>

                <div class="field-group">
                  <label for="f-baths">Bathrooms</label>
                  <input id="f-baths" name="bathrooms" type="number" min="0" max="100" step="1" placeholder="0" />
                </div>

                <div class="field-group">
                  <label for="f-area">Size / area</label>
                  <input id="f-area" name="area" type="text" maxlength="100" placeholder="e.g. 450 sqm" />
                </div>
              </div>

              <div class="field-divider"></div>

              <div class="field-group">
                <label for="f-description">
                  Property description
                  <span class="required" aria-hidden="true">*</span>
                </label>
                <textarea
                  id="f-description"
                  name="description"
                  rows="6"
                  minlength="20"
                  maxlength="5000"
                  placeholder="Describe the property — its condition, key features, access, nearby amenities and anything else buyers or renters should know."
                  required
                ></textarea>
                <div class="char-counter">
                  <span id="desc-count">0</span> / 5000
                </div>
              </div>

            </div>
          </section>

          <!-- ── Section 2: Images ── -->
          <section class="form-section" id="section-images">
            <div class="section-header">
              <span class="section-number" aria-hidden="true">02</span>
              <div>
                <h2>Property images</h2>
                <p class="section-desc">Add up to 5 photos — upload files or paste image links.</p>
              </div>
            </div>

            <div class="fields">

              <!-- Drop zone -->
              <div
                id="drop-zone"
                class="drop-zone"
                role="button"
                tabindex="0"
                aria-label="Upload property photos"
              >
                <input
                  id="images"
                  name="images"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  multiple
                  class="sr-only"
                  aria-hidden="true"
                  tabindex="-1"
                />
                <div class="drop-zone-inner">
                  <div class="drop-icon" aria-hidden="true">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                  <p class="drop-primary">Drag photos here, or <span class="drop-link">browse files</span></p>
                  <p class="drop-secondary">JPEG, PNG or WebP · max 5 MB each · up to 5 images</p>
                </div>
              </div>

              <!-- File thumbnails -->
              <div id="file-preview" class="img-preview-strip" aria-live="polite" aria-label="Selected photos"></div>

              <!-- URL inputs -->
              <div class="url-section">
                <p class="url-section-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  Or paste image URLs
                </p>
                <div id="url-slots" class="url-slot-list"></div>
                <button id="add-url-btn" type="button" class="add-url-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  Add image URL
                </button>
              </div>

              <!-- Limit / counter row -->
              <div class="img-status-row">
                <span id="img-counter" class="img-counter">0 / 5 images</span>
                <span id="img-limit-msg" class="img-limit-msg" hidden>Limit reached — remove an image to add more.</span>
              </div>

              <div class="video-upload-card">
                <div>
                  <h3>Show the property in a video <span class="optional-tag">optional</span></h3>
                  <p>Add a YouTube or Vimeo link, a direct MP4/WebM link, or upload a short video.</p>
                </div>
                <div class="field-group">
                  <label for="f-video-url">Video link</label>
                  <input
                    id="f-video-url"
                    name="videoUrl"
                    type="url"
                    maxlength="2048"
                    placeholder="https://youtu.be/… or https://vimeo.com/…"
                    autocomplete="url"
                  />
                  <p class="field-hint">Supported links: YouTube, Vimeo, MP4, or WebM.</p>
                </div>
                <div class="field-group">
                  <label for="f-video-file">Or upload a video</label>
                  <input
                    id="f-video-file"
                    name="videoFile"
                    type="file"
                    accept="video/mp4,video/webm"
                  />
                  <p class="field-hint">MP4 or WebM, up to 4 MB. Uploading a video replaces the link.</p>
                </div>
                <div id="f-video-preview" class="video-preview" hidden>
                  <video controls muted playsinline preload="metadata"></video>
                  <button id="f-video-remove" type="button" class="remove-video-button">Remove selected video</button>
                </div>
              </div>

            </div>
          </section>

          <!-- ── Section 3: Contact ── -->
          <section class="form-section" id="section-contact">
            <div class="section-header">
              <span class="section-number" aria-hidden="true">03</span>
              <div>
                <h2>Your contact details</h2>
                <p class="section-desc">We'll use these to verify your submission and reach you.</p>
              </div>
            </div>

            <div class="fields">

              <div class="field-group">
                <label for="f-name">
                  Full name
                  <span class="required" aria-hidden="true">*</span>
                </label>
                <input
                  id="f-name"
                  name="submitterName"
                  type="text"
                  minlength="2"
                  maxlength="120"
                  autocomplete="name"
                  placeholder="Your full name"
                  required
                />
              </div>

              <div class="field-row">
                <div class="field-group">
                  <label for="f-phone">
                    Phone number
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <input
                    id="f-phone"
                    name="submitterPhone"
                    type="tel"
                    minlength="7"
                    maxlength="30"
                    autocomplete="tel"
                    placeholder="e.g. 08012345678"
                    required
                  />
                </div>

                <div class="field-group">
                  <label for="f-email">Email address</label>
                  <input
                    id="f-email"
                    name="submitterEmail"
                    type="email"
                    maxlength="254"
                    autocomplete="email"
                    placeholder="you@example.com"
                  />
                </div>
              </div>

            </div>
          </section>

          <!-- Honeypot -->
          <div class="honeypot" aria-hidden="true">
            <label>
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <!-- Form footer -->
          <div class="form-footer">
            <p class="privacy-note">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Submission does not guarantee publication. FHA will review before
              deciding whether to list your property.
            </p>

            <div id="form-message" class="form-message" role="alert" aria-live="polite" hidden></div>

            <button id="submit-button" type="submit" class="submit-btn">
              <span class="btn-label">Submit property for review</span>
              <span class="btn-spinner" aria-hidden="true" hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                </svg>
              </span>
            </button>
          </div>

        </form>
      </div>

      <!-- ── Right: sticky sidebar ── -->
      <aside class="sidebar">
        <div class="sidebar-sticky">

          <div class="sidebar-card process-card">
            <h3>How it works</h3>
            <ol class="process-steps">
              <li>
                <span class="step-dot" aria-hidden="true">1</span>
                <div>
                  <strong>Fill in your details</strong>
                  <p>Tell us about the property and how to reach you.</p>
                </div>
              </li>
              <li>
                <span class="step-dot" aria-hidden="true">2</span>
                <div>
                  <strong>We review your listing</strong>
                  <p>Our team verifies the information within 48 hours.</p>
                </div>
              </li>
              <li>
                <span class="step-dot" aria-hidden="true">3</span>
                <div>
                  <strong>Your property goes live</strong>
                  <p>Approved listings appear on the public website immediately.</p>
                </div>
              </li>
            </ol>
          </div>

          <div class="sidebar-card tips-card">
            <h3>Tips for a great listing</h3>
            <ul class="tips-list">
              <li>Use a clear, specific title — include the area and key feature.</li>
              <li>Upload at least one photo — listings with images get 3× more views.</li>
              <li>Set a realistic price or note "Negotiable" if flexible.</li>
              <li>Describe the property thoroughly — size, condition, facilities.</li>
              <li>Double-check your phone number — this is how we'll contact you.</li>
            </ul>
          </div>

          <div class="sidebar-card contact-card">
            <p class="contact-label">Need Assistance?</p>
            <p>Our team is available to help with submissions:</p>
            <div class="sidebar-contact-lines">
              <a href="tel:+2348039145619" class="sidebar-phone-link">
                📞 +234 803 914 5619
              </a>
              <a href="tel:+2349066715348" class="sidebar-phone-link">
                📞 +234 906 671 5348
              </a>
              <a
                href="https://wa.me/2348039145619?text=Hello%20FHA%20Properties%20Management%2C%20I%20have%20a%20question%20about%20submitting%20a%20property."
                target="_blank"
                rel="noopener noreferrer"
                class="sidebar-wa-link"
              >
                💬 Chat on WhatsApp
              </a>
              <a href="mailto:fehintolahayodeji@gmail.com" class="contact-email">
                fehintolahayodeji@gmail.com
              </a>
            </div>
          </div>

        </div>
      </aside>
    </div>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── Layout tokens ── */
  .container-wide {
    width: min(1200px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* ── Page hero ── */
  .page-hero {
    background:
      radial-gradient(circle at 88% 6%, rgb(255 255 255 / 12%), transparent 28%),
      linear-gradient(120deg, var(--color-brand-deep), var(--color-brand));
    color: var(--color-ivory);
    padding: 72px 0 64px;
    overflow: hidden;
  }

  .page-hero-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }

  .eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--color-sand);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .page-hero h1 {
    margin: 0 0 14px;
    font-family: inherit;
    font-size: clamp(2.8rem, 5.6vw, 4.8rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 1.02;
    color: var(--color-ivory);
  }

  .page-hero h1 em {
    color: #f1cf76;
    font-style: normal;
  }

  .hero-sub {
    max-width: 480px;
    margin: 0;
    color: var(--color-slate);
    font-size: 0.97rem;
    line-height: 1.85;
  }

  .hero-trust {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 6px;
    flex-shrink: 0;
    padding: 20px 22px;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 8%);
    backdrop-filter: blur(8px);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-slate);
    font-size: 0.86rem;
  }

  .trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgb(200 152 31 / 22%);
    color: var(--color-brand-deep);
    font-size: 0.7rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ── Page body ── */
  .page-body {
    display: grid;
    grid-template-columns: 1fr 340px;
    align-items: start;
    gap: 40px;
    padding-top: 60px;
    padding-bottom: 100px;
  }

  /* ── Success screen ── */
  .success-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 64px 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-ivory);
    box-shadow: var(--shadow-card);
  }

  .success-icon {
    margin-bottom: 24px;
  }

  .success-screen h2 {
    margin: 0 0 14px;
    font-family: inherit;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.055em;
  }

  .success-screen > p {
    max-width: 400px;
    margin: 0 0 32px;
    color: var(--color-slate-blue);
    line-height: 1.8;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--color-brand);
    color: var(--color-ivory);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 150ms;
  }

  .btn-primary:hover {
    background: var(--color-brand-deep);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-gray);
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: color 150ms, text-decoration-color 150ms;
  }

  .btn-ghost:hover {
    color: var(--color-brand);
    text-decoration-color: var(--color-border);
  }

  /* ── Form ── */
  .submission-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .form-progress {
    position: sticky;
    top: 120px;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0 0 20px;
    padding: 10px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: rgb(255 255 255 / 94%);
    box-shadow: 0 8px 24px rgb(29 28 26 / 8%);
