  const descTA      = document.querySelector("#f-description");
  const descCount   = document.querySelector("#desc-count");
  const priceInput = document.querySelector<HTMLInputElement>("#f-price");
  const agentFeeInput = document.querySelector<HTMLInputElement>("#f-agent-fee");
  const pricePreview = document.querySelector("#f-price-preview");
  const previewAsking = document.querySelector("#f-preview-asking");
  const previewFeeRow = document.querySelector("#f-preview-fee-row");
  const previewFeeLabel = document.querySelector("#f-preview-fee-label");
  const previewFee = document.querySelector("#f-preview-fee");
  const previewTotal = document.querySelector("#f-preview-total");
  const previewNote = document.querySelector("#f-preview-note");
  const successScreen = document.querySelector("#success-screen");
  const submitAnother = document.querySelector("#submit-another");
  const videoFileInput = document.querySelector<HTMLInputElement>("#f-video-file");
  const videoUrlInput = document.querySelector<HTMLInputElement>("#f-video-url");
  const videoPreview = document.querySelector("#f-video-preview");
  const videoPreviewPlayer = videoPreview?.querySelector("video");
  const videoRemoveButton = document.querySelector("#f-video-remove");
  const progressLinks = document.querySelectorAll("[data-progress-step]");
  let selectedVideoUrl = "";

  function updatePricePreview() {
    if (
      !priceInput ||
      !agentFeeInput ||
      !pricePreview ||
      !previewAsking ||
      !previewFeeRow ||
      !previewFeeLabel ||
      !previewFee ||
      !previewTotal ||
      !previewNote
    ) {
      return;
    }

    const rawPrice = priceInput.value;
    const rawFee = agentFeeInput.value;
    const price = Number(rawPrice);
    const feePercent = Number(rawFee);
    const hasPrice = rawPrice.trim() !== "" && Number.isFinite(price) && price >= 0;
    const validFee =
      rawFee.trim() === "" ||
      (Number.isFinite(feePercent) && feePercent >= 0 && feePercent <= 100);

    if (!hasPrice) {
      pricePreview.hidden = true;
      return;
    }

    pricePreview.hidden = false;
    previewAsking.textContent = formatNaira(price);

    if (!validFee) {
      previewFeeRow.hidden = true;
      previewTotal.textContent = "—";
      previewNote.textContent = "Enter an agent fee between 0% and 100% to calculate the buyer total.";
      return;
    }

    const breakdown = getPropertyPriceBreakdown(price, feePercent);
    if (!breakdown) {
      pricePreview.hidden = true;
      return;
    }

    previewTotal.textContent = formatNaira(breakdown.totalAmount);
    previewFeeRow.hidden = feePercent <= 0;
    previewFeeLabel.textContent = `Agent fee (${feePercent}%)`;
    previewFee.textContent = formatNaira(breakdown.feeAmount);
    previewNote.textContent =
      feePercent > 0
        ? "The fee is calculated from the asking price and added to the buyer-facing total."
        : "No agent fee is included in the buyer-facing total.";
  }

  priceInput?.addEventListener("input", updatePricePreview);
  agentFeeInput?.addEventListener("input", updatePricePreview);
  updatePricePreview();

  // ── Character counter ──
  descTA?.addEventListener("input", () => {
    if (descCount) descCount.textContent = descTA.value.length;
  });

  videoFileInput?.addEventListener("change", () => {
    if (!videoFileInput) return;
    const file = videoFileInput.files?.[0];
    if (!file) return;

    if (!["video/mp4", "video/webm"].includes(file.type) || file.size > 4 * 1024 * 1024) {
      showMessage("Choose an MP4 or WebM video that is 4 MB or smaller.");
      videoFileInput.value = "";
      return;
    }

    if (videoUrlInput) videoUrlInput.value = "";
    if (selectedVideoUrl) URL.revokeObjectURL(selectedVideoUrl);
    selectedVideoUrl = URL.createObjectURL(file);
    if (videoPreviewPlayer instanceof HTMLVideoElement) {
      videoPreviewPlayer.src = selectedVideoUrl;
    }
    if (videoPreview) videoPreview.hidden = false;
  });

  videoUrlInput?.addEventListener("input", () => {
    if (!videoUrlInput) return;
    if (!videoUrlInput.value) return;
    if (videoFileInput) videoFileInput.value = "";
    if (selectedVideoUrl) URL.revokeObjectURL(selectedVideoUrl);
    selectedVideoUrl = "";
    if (videoPreviewPlayer instanceof HTMLVideoElement) {
      videoPreviewPlayer.removeAttribute("src");
      videoPreviewPlayer.load();
    }
    if (videoPreview) videoPreview.hidden = true;
  });

  videoRemoveButton?.addEventListener("click", () => {
    if (videoFileInput) videoFileInput.value = "";
    if (selectedVideoUrl) URL.revokeObjectURL(selectedVideoUrl);
    selectedVideoUrl = "";
    if (videoPreviewPlayer instanceof HTMLVideoElement) {
      videoPreviewPlayer.removeAttribute("src");
      videoPreviewPlayer.load();
    }
    if (videoPreview) videoPreview.hidden = true;
  });

  if ("IntersectionObserver" in window && progressLinks.length) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        const currentSection = entries
          .filter((entry) => entry.isIntersecting)
          .sort((first, second) => second.intersectionRatio - first.intersectionRatio)[0];
        if (!currentSection) return;
        progressLinks.forEach((link) => {
          if (link.getAttribute("href") === `#${currentSection.target.id}`) {
            link.setAttribute("aria-current", "step");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      },
      { rootMargin: "-20% 0px -55% 0px", threshold: [0, 0.25, 0.5] },
    );

    progressLinks.forEach((link) => {
      const section = document.getElementById(link.dataset.progressStep);
      if (section) sectionObserver.observe(section);
    });
  }

  // ── Image management ──
  let dt = new DataTransfer();

  function countImages() {
    const urlCount = urlSlots?.querySelectorAll("input[type=url]").length ?? 0;
    return dt.files.length + urlCount;
  }

  function refreshUI() {
    const total   = countImages();
    const atLimit = total >= MAX_IMAGES;

    if (imgCounter) imgCounter.textContent = `${total} / ${MAX_IMAGES} image${total !== 1 ? "s" : ""}`;
    if (limitMsg)   limitMsg.hidden = !atLimit;
    if (addUrlBtn)  addUrlBtn.disabled = atLimit;

    if (dropZone) {
      dropZone.style.opacity       = atLimit ? "0.45" : "";
      dropZone.style.pointerEvents = atLimit ? "none" : "";
    }
  }

  function renderFilePreviews() {
    if (!filePreview) return;
    filePreview.innerHTML = "";

    Array.from(dt.files).forEach((file, index) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const thumb  = document.createElement("div");
        thumb.className = "img-thumb";

        const img    = document.createElement("img");
        img.src      = e.target.result;
        img.alt      = file.name;

        const removeBtn = document.createElement("button");
        removeBtn.type  = "button";
        removeBtn.className = "img-thumb-remove";
        removeBtn.setAttribute("aria-label", `Remove ${file.name}`);
        removeBtn.textContent = "×";
        removeBtn.addEventListener("click", () => {
          const newDt = new DataTransfer();
          Array.from(dt.files).forEach((f, i) => { if (i !== index) newDt.items.add(f); });
          dt = newDt;
          renderFilePreviews();
          refreshUI();
        });

        thumb.appendChild(img);
        thumb.appendChild(removeBtn);
        filePreview.appendChild(thumb);
      };
      reader.readAsDataURL(file);
    });

    refreshUI();
  }

  function addFilesToDt(files) {
    if (formMsg) formMsg.hidden = true;
    const urlCount  = urlSlots?.querySelectorAll("input[type=url]").length ?? 0;
    const remaining = MAX_IMAGES - dt.files.length - urlCount;
    const incoming = Array.from(files);
    const invalidFiles = incoming.filter(
      (file) =>
        !ALLOWED_IMAGE_TYPES.has(file.type) ||
        file.size === 0 ||
        file.size > MAX_IMAGE_SIZE,
    );
    const validFiles = incoming.filter(
      (file) =>
        ALLOWED_IMAGE_TYPES.has(file.type) &&
        file.size > 0 &&
        file.size <= MAX_IMAGE_SIZE,
    );
    const uniqueFiles = validFiles.filter(
      (file) =>
        !Array.from(dt.files).some(
          (existing) => existing.name === file.name && existing.size === file.size,
        ),
    );

    if (invalidFiles.length) {
      showMessage("Photos must be JPEG, PNG, or WebP files no larger than 5 MB each.");
    }
    if (uniqueFiles.length > remaining) {
      showMessage(`Only ${Math.max(remaining, 0)} more photos can be added. The limit is ${MAX_IMAGES} total.`);
    }

    uniqueFiles.slice(0, Math.max(remaining, 0)).forEach((file) => dt.items.add(file));

    fileInput.value = "";
    renderFilePreviews();
  }

  // File input change
  fileInput?.addEventListener("change", () => addFilesToDt(fileInput.files));

  // Drag-and-drop
  dropZone?.addEventListener("click", () => fileInput?.click());
  dropZone?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fileInput?.click(); }
  });

  ["dragenter", "dragover"].forEach((evt) => {
    dropZone?.addEventListener(evt, (e) => { e.preventDefault(); dropZone.classList.add("drag-over"); });
  });

  ["dragleave", "drop"].forEach((evt) => {
    dropZone?.addEventListener(evt, (e) => { e.preventDefault(); dropZone.classList.remove("drag-over"); });
  });

  dropZone?.addEventListener("drop", (e) => {
    const files = e.dataTransfer?.files;
    if (files?.length) addFilesToDt(files);
  });

  // URL slot
  function addUrlSlot() {
    if (!urlSlots || countImages() >= MAX_IMAGES) return;

    const slot      = document.createElement("div");
    slot.className  = "url-slot";

    const input           = document.createElement("input");
    input.type            = "url";
    input.name            = "imageUrls";
    input.placeholder     = "https://example.com/photo.jpg";
    input.required        = true;
    input.pattern         = "https://.+";
    input.title           = "Enter a direct HTTPS image URL.";
    input.setAttribute("aria-label", "Image URL");

    const rm            = document.createElement("button");
    rm.type             = "button";
    rm.className        = "url-slot-remove";
    rm.setAttribute("aria-label", "Remove URL");
    rm.textContent      = "×";
    rm.addEventListener("click", () => { slot.remove(); refreshUI(); });

    slot.appendChild(input);
    slot.appendChild(rm);
    urlSlots.appendChild(slot);
    input.focus();
    refreshUI();
  }

  addUrlBtn?.addEventListener("click", addUrlSlot);

  // ── Submit ──
  function setLoading(loading) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    submitBtn.querySelector(".btn-label").textContent = loading ? "Submitting…" : "Submit property for review";
    const spinner = submitBtn.querySelector(".btn-spinner");
    if (spinner) spinner.hidden = !loading;
  }

  function showMessage(text, type = "info") {
    if (!formMsg) return;
    formMsg.textContent = text;
    formMsg.className   = `form-message ${type === "success" ? "is-success" : "is-error"}`;
    formMsg.hidden      = false;
    formMsg.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (countImages() > MAX_IMAGES) {
      showMessage(`Please add at most ${MAX_IMAGES} images in total.`);
      return;
    }

    if (!form.reportValidity()) return;

    setLoading(true);
    if (formMsg) formMsg.hidden = true;

    try {
      const fd = new FormData(form);
      fd.delete("images");
      fd.delete("videoFile");
      const preparedImages = await preparePropertyImages(dt.files);
      preparedImages.forEach((file) => fd.append("images", file));

      const videoFile = videoFileInput?.files?.[0];
      if (videoFile) {
        const buttonLabel = submitBtn?.querySelector(".btn-label");
        if (buttonLabel) buttonLabel.textContent = "Uploading video…";
        const uploadedVideoUrl = await uploadPropertyVideoFile(videoFile);
        fd.set("videoUrl", uploadedVideoUrl);
        if (videoUrlInput) videoUrlInput.value = uploadedVideoUrl;
        if (videoFileInput) videoFileInput.value = "";
      }

      const res    = await fetch("/api/properties/submit", { method: "POST", body: fd });
      const result = await res.json();

      if (res.ok && result.success) {
        // Show success screen
        form.hidden           = true;
        successScreen.hidden  = false;
        successScreen.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        showMessage(result.message || result.error || "Something went wrong.");
      }
    } catch (error) {
      showMessage(
        error instanceof PropertyImagePreparationError
          ? error.message
          : error instanceof Error
            ? error.message
            : "We couldn't reach the server. Check your connection and try again.",
      );
    } finally {
      setLoading(false);
    }
  });

  // Reset to show form again
  submitAnother?.addEventListener("click", () => {
    form.reset();
    videoRemoveButton?.click();
    form.hidden          = false;
    successScreen.hidden = true;
    dt = new DataTransfer();
    if (filePreview) filePreview.innerHTML = "";
    if (urlSlots)    urlSlots.innerHTML    = "";
    if (descCount)   descCount.textContent = "0";
    refreshUI();
    form.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  refreshUI();
</script>
