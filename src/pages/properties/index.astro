
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PropertyCard from "../../components/PropertyCard.astro";
import { connectDB } from "../../lib/db.js";
import Property from "../../models/Property.js";

let properties = [];
let databaseError = false;

try {
  await connectDB();

  properties = await Property.find({
    status: "published",
  })
    .sort({ publishedAt: -1, createdAt: -1 })
    .lean();
} catch (error) {
  console.error("Failed to load published properties:", error);
  databaseError = true;
}

const states = [
  ...new Set(properties.map((property) => property.state).filter(Boolean)),
].sort();
---

<BaseLayout
  title="Properties | FHA Properties Management"
  description="Explore verified property listings from FHA Properties Management across Nigeria."
>
  <Header />

  <main>
    <section class="properties-hero">
      <div class="container">
        <p class="eyebrow">FHA PROPERTIES MANAGEMENT</p>
        <h1>Find a property that fits your plans.</h1>
        <p class="intro">
          Explore available properties and land, or contact our team for
          assistance with your next investment.
        </p>
      </div>
    </section>

    <section class="container listings-section">
      <form id="property-filters" class="filters">
        <label>
          <span>Location</span>
          <select name="state" id="filter-state">
            <option value="">All states</option>
            {states.map((state) => (
              <option value={state}>{state}</option>
            ))}
          </select>
        </label>

        <label>
          <span>Property type</span>
          <select name="type" id="filter-type">
            <option value="">All property types</option>
            <option value="House">House</option>
            <option value="Land">Land</option>
            <option value="Commercial">Commercial</option>
            <option value="Apartment">Apartment</option>
          </select>
        </label>

        <label>
          <span>Listing type</span>
          <select name="listingType" id="filter-listing">
            <option value="">Sale or rent</option>
            <option value="Sale">For sale</option>
            <option value="Rent">For rent</option>
          </select>
        </label>

        <button type="submit">Filter properties</button>
      </form>

      <div class="listings-heading">
        <div>
          <p class="eyebrow">PROPERTY LISTINGS</p>
          <h2>Available properties</h2>
        </div>

        <p id="results-count">{properties.length} properties</p>
      </div>

      {databaseError ? (
        <div class="empty-state">
          <h3>Properties are temporarily unavailable.</h3>
          <p>Please try again later or contact our team for assistance.</p>
        </div>
      ) : properties.length > 0 ? (
        <div class="property-grid" id="property-grid">
          {properties.map((property) => (
            <div
              class="property-item"
              data-state={property.state || ""}
              data-type={property.type || ""}
              data-listing={property.listingType || ""}
            >
              <PropertyCard
                image={property.images?.[0]}
                title={property.title}
                location={[property.city, property.state].filter(Boolean).join(", ")}
                price={
                  property.priceLabel ||
                  (property.priceAmount != null
                    ? `₦${Number(property.priceAmount).toLocaleString("en-NG")}`
                    : "Price on request")
                }
                type={property.type}
                listingType={property.listingType}
                beds={property.bedrooms ?? "—"}
                baths={property.bathrooms ?? "—"}
                area={property.area || "Contact us for details"}
                href={`/properties/${property.slug}/`}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3>No published properties yet.</h3>
          <p>
            Our team is preparing listings. Contact FHA Properties Management
            if you need help finding a property.
          </p>
        </div>
      )}

      <p id="no-matches" class="empty-state" hidden>
        No properties match your selected filters. Try different options.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .properties-hero {
    padding: 84px 0 64px;
    background: var(--color-ivory);
  }

  .eyebrow {
    color: var(--color-brand);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  h1 {
    max-width: 760px;
    margin: 16px 0;
    color: var(--color-ink);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 600px;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .listings-section {
    padding-top: 52px;
    padding-bottom: 90px;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    align-items: end;
    gap: 16px;
    margin-bottom: 56px;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .filters label {
    display: grid;
    gap: 9px;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .filters select,
  .filters button {
    min-height: 46px;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-ivory);
    font: inherit;
  }

  .filters button {
    padding-inline: 20px;
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: var(--color-ivory);
    cursor: pointer;
  }

  .listings-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .listings-heading h2 {
    margin: 8px 0 0;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    letter-spacing: -0.035em;
  }

  #results-count {
    color: var(--color-slate-blue);
    font-size: 0.9rem;
  }

  .property-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .property-item[hidden] {
    display: none;
  }

  .empty-state {
    padding: 48px 24px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-align: center;
  }

  .empty-state h3 {
    margin-bottom: 10px;
  }

  .empty-state p {
    color: var(--color-muted);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .property-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .properties-hero {
      padding: 60px 0 44px;
    }

    .filters,
    .property-grid {
      grid-template-columns: 1fr;
    }

    .filters {
      padding: 16px;
      margin-bottom: 42px;
    }

    .listings-heading {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>

<script>
  const form = document.querySelector("#property-filters");
  const stateFilter = document.querySelector("#filter-state");
  const typeFilter = document.querySelector("#filter-type");
  const listingFilter = document.querySelector("#filter-listing");
  const items = Array.from(document.querySelectorAll(".property-item"));
  const count = document.querySelector("#results-count");
  const noMatches = document.querySelector("#no-matches");

  function applyFilters() {
    let visible = 0;

    for (const item of items) {
      const matchesState =
        !stateFilter.value || item.dataset.state === stateFilter.value;

      const matchesType =
        !typeFilter.value || item.dataset.type === typeFilter.value;

      const matchesListing =
        !listingFilter.value ||
        item.dataset.listing === listingFilter.value;

      const matches = matchesState && matchesType && matchesListing;

      item.hidden = !matches;

      if (matches) visible++;
    }

    count.textContent = `${visible} ${visible === 1 ? "property" : "properties"}`;
    noMatches.hidden = visible !== 0;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    applyFilters();
  });

  stateFilter?.addEventListener("change", applyFilters);
  typeFilter?.addEventListener("change", applyFilters);
  listingFilter?.addEventListener("change", applyFilters);
</script>
