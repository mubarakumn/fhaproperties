---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PropertySearch from "../components/PropertySearch.astro";
import PropertyCard from "../components/PropertyCard.astro";
import LocationShowcase from "../components/LocationShowcase.astro";
import Services from "../components/Services.astro";
import SubmissionCTA from "../components/SubmissionCTA.astro";
import Footer from "../components/Footer.astro";
import { connectDB } from "../lib/db.js";
import {
  getPropertyLocationSummaries,
} from "../lib/propertyLocations.js";
import Property from "../models/Property.js";

let featuredProperties = [];
let locationProperties = [];
let states = [];
let listingsUnavailable = false;

try {
  await connectDB();
  featuredProperties = await Property.find({
    status: { $in: ["published", "sold"] },
  })
    .sort({ publishedAt: -1, createdAt: -1 })
    .limit(3)
    .lean();

  const propertyStates = await Property.distinct("state", {
    status: { $in: ["published", "sold"] },
  });
  states = [...new Set(propertyStates.filter(Boolean))].sort();
  locationProperties = await Property.find({
    status: { $in: ["published", "sold"] },
  })
    .select("city state")
    .lean();
} catch (error) {
  console.error("Failed to load homepage properties:", error);
  listingsUnavailable = true;
}

const locationSummaries = getPropertyLocationSummaries(locationProperties);
---

<BaseLayout>
  <Header />
  <main>
    <Hero />

    <div class="container search-container">
      <PropertySearch states={states} />
    </div>

    <section class="featured-section">
      <div class="container">
        <div class="section-top">
          <div>
            <span class="eyebrow">Explore opportunities</span>
            <h2 class="section-heading">Find your next property.</h2>
            <p class="section-description">
              Discover residential, commercial and land opportunities across Nigeria.
            </p>
          </div>
          <a class="text-link" href="/properties/">View all properties <span>→</span></a>
        </div>

        {listingsUnavailable ? (
          <div class="listings-empty" role="status">
            <h3>Listings are temporarily unavailable.</h3>
            <p>Please try again later or browse the properties page.</p>
            <a href="/properties/">Browse properties</a>
          </div>
        ) : featuredProperties.length > 0 ? (
          <div class="property-grid">
            {featuredProperties.map((property) => (
              <PropertyCard
                image={property.images?.[0]}
                title={property.title}
                location={[property.city, property.state].filter(Boolean).join(", ") || "Location available on request"}
                priceAmount={property.priceAmount}
                priceLabel={property.priceLabel}
                agentFeePercent={property.agentFeePercent}
                type={property.type || "Property"}
                listingType={property.listingType || "Sale"}
                status={property.status}
                beds={property.bedrooms}
                baths={property.bathrooms}
                area={property.area}
                href={`/properties/${property.slug}/`}
              />
            ))}
          </div>
        ) : (
          <div class="listings-empty">
            <h3>No published properties yet.</h3>
            <p>Our team is preparing verified listings. Browse all properties or submit one for review.</p>
            <div class="empty-actions">
              <a href="/properties/">Browse properties</a>
              <a href="/submit-property/">Submit a property</a>
            </div>
          </div>
        )}
      </div>
    </section>

    <LocationShowcase
      locations={locationSummaries}
      heading="Explore properties across Nigeria"
      eyebrow="Browse by location"
    />

    <Services />

    <section class="trust-section" aria-labelledby="trust-heading">
      <div class="container trust-inner">
        <div class="trust-intro">
          <p class="eyebrow">A clearer way forward</p>
          <h2 id="trust-heading">Know what happens at every step.</h2>
          <p>
            Property decisions matter. We keep the process clear, with review
            before publication and direct contact for the details that count.
          </p>
          <a href="/contact/" class="trust-contact-link">Talk to our team <span aria-hidden="true">↗</span></a>
        </div>

        <ol class="trust-steps">
          <li>
            <span class="trust-step-number">01</span>
            <div>
              <h3>Browse property listings</h3>
              <p>Review the details shared for each property and explore photos where available.</p>
            </div>
          </li>
          <li>
            <span class="trust-step-number">02</span>
            <div>
              <h3>Listings reviewed before publishing</h3>
              <p>Public property submissions are reviewed by the FHA team before they appear on the website.</p>
            </div>
          </li>
          <li>
            <span class="trust-step-number">03</span>
            <div>
              <h3>Confirm before you commit</h3>
              <p>Contact the team to confirm current availability, terms, and property documentation before making a decision.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <SubmissionCTA />
  </main>
  <Footer />
</BaseLayout>

<style>
  .featured-section {
    padding: 30px 0 85px;
  }

  .search-container {
    position: relative;
    z-index: 2;
  }

  .section-top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 32px;
  }

  .section-description {
    max-width: 560px;
    margin: 0;
    color: var(--color-slate-blue);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .text-link {
    flex-shrink: 0;
    padding-bottom: 8px;
    font-size: 0.83rem;
    font-weight: 700;
  }

  .text-link span {
    margin-left: 7px;
    color: var(--color-gold);
  }

  .property-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .trust-section {
    padding: 82px 0;
    background: #f6f8fb;
  }

  .trust-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(38px, 7vw, 90px);
  }

  .trust-intro h2 {
    max-width: 440px;
    margin: 12px 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 1.1;
  }

  .trust-intro > p:not(.eyebrow) {
    max-width: 440px;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .trust-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    color: var(--color-brand);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .trust-contact-link span {
    color: var(--color-gold);
  }

  .trust-steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-steps li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 18px;
    padding: 0 0 24px;
  }

  .trust-steps li + li {
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .trust-step-number {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgb(18 59 112 / 18%);
    border-radius: 50%;
    background: #fff;
    color: var(--color-brand);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .trust-steps h3 {
    margin: 0 0 5px;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .trust-steps p {
    max-width: 510px;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .listings-empty {
    padding: 30px;
    border: 1px solid var(--color-border);
    background: var(--color-ivory);
  }

  .listings-empty h3 {
    margin: 0 0 8px;
    font-family: Georgia, serif;
    font-size: 1.25rem;
    font-weight: 400;
  }

  .listings-empty p {
    margin: 0;
    color: var(--color-slate-blue);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 18px;
  }

  .empty-actions a,
  .listings-empty > a {
    color: var(--color-brand);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .featured-section {
      padding-bottom: 60px;
    }

    .property-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .section-top {
      align-items: flex-start;
      flex-direction: column;
    }

    .trust-section {
      padding: 60px 0;
    }

    .trust-inner {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  @media (max-width: 520px) {
    .property-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
